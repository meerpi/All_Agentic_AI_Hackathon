{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/chat", "destination": "/chat.html" },
    { "source": "/auth", "destination": "/auth.html" },
    { "source": "/login", "destination": "/auth.html" },
    { "source": "/register", "destination": "/auth.html" },
    { "source": "/features", "destination": "/features.html" },
    { "source": "/tools", "destination": "/features.html" },
    { "source": "/architecture", "destination": "/architecture.html" },
    { "source": "/dag", "destination": "/architecture.html" },
    { "source": "/integrations", "destination": "/integrations.html" },
    { "source": "/static/:match*", "destination": "/frontend/:match*" },
    { "source": "/", "destination": "/index.html" }
  ]
}
