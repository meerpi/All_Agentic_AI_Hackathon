# Gemini API Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Agent Configuration
MOCK_GEMINI=false
LOG_LEVEL=INFO

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Telegram Bot (get token from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Google Workspace OAuth
# No env vars needed — place your credentials.json in the project root.
# On first use, a browser window will open for OAuth consent.
# After consent, token.json is saved locally for automatic refresh.
